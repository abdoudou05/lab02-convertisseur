{
  "name": "convertisseur-lab02",
  "version": "1.0.0",
  "private": true,
  "description": "Convertisseur d'unites — backend Node.js + frontend React/Material UI (Lab 02).",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"#00b3a4,#f2a03d\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "preview": "npm run preview --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
